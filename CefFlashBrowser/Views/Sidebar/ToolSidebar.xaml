<Window x:Class="CefFlashBrowser.Views.Sidebar.ToolSidebar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:modules="clr-namespace:CefFlashBrowser.Views.Sidebar.Modules"
        Width="44"
        Height="44"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Background="Transparent"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid>
        <Border x:Name="sidebarBackground"
                Visibility="Collapsed"
                Background="#FF20242B"
                BorderBrush="#FF343A44"
                BorderThickness="1,0,0,0"/>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="44"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="sidebarTitle"
                       Grid.ColumnSpan="2"
                       Visibility="Collapsed"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="White"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Text="工具"/>

            <ToggleButton x:Name="sidebarToggle"
                          Grid.Column="0"
                          Width="44"
                          Height="44"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Top"
                          Background="#FF2C323B"
                          BorderBrush="#FF59616D"
                          Foreground="White"
                          FontSize="20"
                          Content="☰"
                          ToolTip="打开工具侧边栏"
                          Click="SidebarToggleClick">
                <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="buttonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="buttonBorder"
                                        Property="Background" Value="#FF46515F"/>
                                <Setter TargetName="buttonBorder"
                                        Property="BorderBrush" Value="#FF8795A6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </ToggleButton.Template>
            </ToggleButton>

            <StackPanel x:Name="moduleContainer"
                        Grid.Row="1"
                        Grid.ColumnSpan="2"
                        Visibility="Collapsed"
                        Margin="0,12,0,0">
                <modules:PetCalculatorModule/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
